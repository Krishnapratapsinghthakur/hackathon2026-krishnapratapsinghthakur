# ══════════════════════════════════════════════════════════════
# ShopWave Support Agent — Environment Configuration
# ══════════════════════════════════════════════════════════════
#
# ENVIRONMENT=development → Groq free tier (llama-3.3-70b)  $0.00
# ENVIRONMENT=production  → OpenAI (gpt-4o-mini / gpt-4o)   paid
#
# Just flip ENVIRONMENT and set the right API key. Done.
# ══════════════════════════════════════════════════════════════

ENVIRONMENT=development

# ── API Keys (set the one matching your environment) ──
GROQ_API_KEY=gsk_your-groq-key-here
# OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# GOOGLE_API_KEY=your-google-key-here

# ── Mock tools: simulated upstream timeouts (0 = off, 0.05 = 5% per tool call) ──
# MOCK_TOOL_FAILURE_RATE=0

# ── LLM provider throttling (avoid 429s under load; process-wide) ──
# LLM_MAX_REQUESTS_PER_MINUTE=28
# LLM_MAX_CONCURRENT_CALLS=3
# LLM_MIN_INTERVAL_SECONDS=0.05
# LLM_429_MAX_RETRIES=6
# LLM_429_RETRY_BASE_SECONDS=1.5
# LLM_429_RETRY_MAX_SECONDS=45

# ── Optional overrides (leave blank to use preset defaults) ──
# LLM_PROVIDER=groq
# LLM_MODEL_FAST=llama-3.3-70b-versatile
# LLM_MODEL_POWER=llama-3.3-70b-versatile

# ── Security ──
# Set API_KEY to require X-API-Key header on all endpoints (leave empty to disable)
API_KEY=
# Comma-separated allowed origins (use * for development only)
# Include Next.js dev server for the frontend/ app (default port 3000)
CORS_ORIGINS=https://your-frontend.vercel.app,http://localhost:3000
RATE_LIMIT=60/minute

# ── Redis (caching + Celery broker) ──
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CACHE_TTL_SECONDS=300
CACHE_TICKET_RESULT_TTL=600

# ── Database (Supabase free Postgres) ──
# Get your connection string from: Supabase Dashboard → Settings → Database → URI
DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# ── Routing & Cost ──
LLM_SMART_ROUTING=true
LLM_TEMPERATURE=0.1
COST_TRACKING_ENABLED=true
COST_BUDGET_PER_BATCH=0

# ── Processing ──
MAX_CONCURRENT_TICKETS=10
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2.0
CONFIDENCE_THRESHOLD=0.6
LOG_LEVEL=INFO
